{
  "expo": {
    "name": "走走搭子",
    "slug": "hiking-buddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hiking-buddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "3c2a5d43-f357-443a-b983-936c2fabe54c"
      },
      "router": {}
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hikingbuddy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "需要获取你的位置，用来推荐附近适合走走的地方和路线。",
        "NSCameraUsageDescription": "需要使用相机，用来识别和讲解你路上看到的内容。",
        "NSMicrophoneUsageDescription": "需要使用麦克风，用来支持语音对话。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2f6f4e"
      },
      "package": "com.hikingbuddy.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "需要获取你的位置，用来推荐附近适合走走的地方和路线。"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "需要使用相机，用来识别和讲解你路上看到的内容。"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ]
  }
}
