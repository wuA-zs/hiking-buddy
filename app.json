{
  "expo": {
    "name": "徒步搭子",
    "slug": "hiking-buddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hiking-buddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hikingbuddy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "需要获取你的位置来提供导游讲解",
        "NSCameraUsageDescription": "需要拍照来识别花草和风景",
        "NSMicrophoneUsageDescription": "需要麦克风来语音对话"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2d6a4f"
      },
      "package": "com.hikingbuddy.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "需要获取你的位置来提供导游讲解"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "需要拍照来识别花草和风景"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ]
  }
}
